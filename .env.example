# ==========================================
# IDEA MINER — ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# LLM Provider (Google Gemini API)
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Supported models: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Live Search Provider (SerpApi)
# Get your API key at https://serpapi.com/
SERPAPI_API_KEY=

# Persistence Database (Optional)
# If left empty, Idea Miner defaults to a fully functional local SQLite database (idea_miner.sqlite).
# To connect to Supabase or PostgreSQL in production, supply a connection URI:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
